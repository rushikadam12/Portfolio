---
// Layout.astro — Global HTML shell
// Accepts: title, description, image, type (all optional)
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = "Rushikesh Kadam — AI and Full-Stack Engineer",
  description = "Rushikesh Kadam, SDE-2 at Sciverse Solutions, builds LLM pipelines, FastAPI services and the web applications around them.",
  image = "/profile-photo.jpeg",
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://rushikeshkadam.dev");
const socialImageURL = new URL(image, Astro.site || "https://rushikeshkadam.dev");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary SEO Meta Tags -->
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Rushikesh Kadam" />
    <meta
      name="keywords"
      content="Rushikesh Kadam, AI Engineer, Full Stack Engineer, LangChain, FastAPI, Python, TypeScript, React, Next.js, OpenAI API, Web Development, Portfolio"
    />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme Colors -->
    <meta name="theme-color" content="#f6f7f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1116" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:site_name" content="Rushikesh Kadam Portfolio" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Schema.org JSON-LD Structured Data for Search Engines -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Rushikesh Kadam",
        "jobTitle": "SDE-2, AI and full-stack engineer",
        "worksFor": { "@type": "Organization", "name": "Sciverse Solutions Pvt. Ltd." },
        "url": canonicalURL.href,
        "image": socialImageURL.href,
        "description": description,
        "sameAs": [
          "https://github.com/rushikadam12",
          "https://linkedin.com/in/rushikeshkadam"
        ],
        "knowsAbout": [
          "Artificial Intelligence",
          "Large Language Models",
          "LangChain",
          "FastAPI",
          "Full Stack Development",
          "Python",
          "TypeScript",
          "React",
          "Next.js",
          "Tailwind CSS",
          "PostgreSQL",
          "Docker"
        ]
      })}
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Client-side Page Router & View Transitions -->
    <ClientRouter />

    <!-- Google Fonts: Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Schibsted Grotesk (text) + IBM Plex Mono (code) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Zero-FOUC Dark Mode Initializer & View Transitions Theme Sync -->
    <script is:inline>
      function applyTheme() {
        const storedTheme =
          typeof localStorage !== "undefined"
            ? localStorage.getItem("theme")
            : null;
        const systemDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (storedTheme === "dark" || (!storedTheme && systemDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      }
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
  </head>

  <body class="antialiased">
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
  </body>
</html>
