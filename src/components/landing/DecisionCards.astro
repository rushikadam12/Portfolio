---
// src/components/landing/DecisionCards.astro
// Bifurcated mode-selection grid: Professional card + Engineer card
// Features real profile photo, touch-safe layout, and keyboard shortcuts (1 / 2)
import profilePhoto from "../../assets/profile-photo.jpeg";
---

<!-- ── Ambient glow orbs (contained to prevent horizontal overflow) ── -->
<div class="relative w-full overflow-hidden pointer-events-none">
  <div
    class="absolute -top-32 left-1/4 w-72 sm:w-96 h-72 sm:h-96 bg-primary-fixed/30 rounded-full blur-3xl -z-10"
  >
  </div>
  <div
    class="absolute top-48 right-4 sm:right-10 w-64 sm:w-80 h-64 sm:h-80 bg-secondary-fixed/20 rounded-full blur-3xl -z-10"
  >
  </div>
</div>

<!-- ── Decision Grid ─────────────────────────────────────────── -->
<section
  class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 lg:gap-8 items-stretch w-full mb-8 sm:mb-12"
>
  <!-- ══ CARD 1: Professional ════════════════════════════════ -->
  <div
    id="card-pro"
    class="reveal-on-scroll delay-100 group relative flex flex-col justify-between p-5 sm:p-7 lg:p-8 rounded-2xl bg-surface-container-lowest border border-outline-variant/30 shadow-md card-hover-pro card-spotlight overflow-hidden transition-all duration-300"
  >
    <!-- Top accent line -->
    <div
      class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-primary via-primary-container to-surface-tint"
    >
    </div>

    <div class="flex flex-col gap-4">
      <!-- Card header — wraps on very small screens -->
      <div class="flex items-start justify-between gap-2 flex-wrap">
        <div
          class="w-11 h-11 rounded-xl bg-primary/10 flex items-center justify-center text-primary shadow-xs group-hover:scale-110 transition-transform shrink-0"
        >
          <span class="material-symbols-outlined text-2xl leading-none"
            >business_center</span
          >
        </div>
        <span
          class="px-3 py-1 rounded-full bg-primary text-on-primary font-semibold text-xs tracking-wide shadow-xs flex items-center gap-1 shrink-0"
        >
          <span class="material-symbols-outlined text-sm leading-none"
            >star</span
          >
          Recommended
        </span>
      </div>

      <!-- Title -->
      <div>
        <div class="flex items-baseline gap-2 flex-wrap">
          <h2 class="text-2xl sm:text-3xl font-bold text-on-surface">
            Professional
          </h2>
          <span class="font-mono text-xs text-on-surface-variant font-semibold"
            >MODE 01</span
          >
        </div>
        <p class="text-sm sm:text-base text-on-surface-variant mt-1">
          Meet the person behind the code.
        </p>
      </div>

      <!-- Editorial preview pill with Rushikesh's photo -->
      <div
        class="rounded-xl bg-surface-container-low p-3 sm:p-3.5 flex flex-col gap-2.5 shadow-inner border border-outline-variant/20"
      >
        <div class="flex items-center justify-between gap-2 flex-wrap">
          <div class="flex items-center gap-2.5 min-w-0">
            <img
              src={profilePhoto.src}
              alt="Rushikesh Kadam"
              class="w-9 h-9 rounded-full object-cover shrink-0 ring-2 ring-primary/40 shadow-xs"
            />
            <div class="flex flex-col min-w-0">
              <span
                class="text-xs sm:text-sm text-on-surface font-semibold truncate leading-tight"
                >Executive Dossier</span
              >
              <span class="text-xs text-on-surface-variant truncate"
                >Editorial · Projects · Leadership</span
              >
            </div>
          </div>
          <span
            class="font-mono text-xs text-primary bg-primary/10 px-2 py-0.5 rounded-full font-bold shrink-0"
            >v1.0</span
          >
        </div>
        <div
          class="p-2.5 rounded-lg bg-surface-container-lowest text-on-surface shadow-xs"
        >
          <p
            class="text-xs sm:text-sm text-on-surface italic leading-relaxed line-clamp-2"
          >
            "Shipped 3 production SaaS apps serving 10k+ users; led architecture
            decisions on cross-team integrations."
          </p>
        </div>
      </div>

      <!-- Feature bullets -->
      <ul class="space-y-1.5 text-xs sm:text-sm text-on-surface-variant">
        <li class="flex items-center gap-2.5">
          <span
            class="material-symbols-outlined text-primary text-base leading-none shrink-0"
            >verified</span
          >
          <span>Clean narrative format &amp; leadership philosophy</span>
        </li>
        <li class="flex items-center gap-2.5">
          <span
            class="material-symbols-outlined text-primary text-base leading-none shrink-0"
            >view_timeline</span
          >
          <span>In-depth project case studies &amp; business impact</span>
        </li>
        <li class="flex items-center gap-2.5">
          <span
            class="material-symbols-outlined text-primary text-base leading-none shrink-0"
            >history_edu</span
          >
          <span>Career progression &amp; growth timeline</span>
        </li>
        <li class="flex items-center gap-2.5">
          <span
            class="material-symbols-outlined text-primary text-base leading-none shrink-0"
            >group_work</span
          >
          <span>Cross-functional results &amp; architecture decisions</span>
        </li>
      </ul>
    </div>

    <!-- CTA -->
    <div class="pt-5 mt-2">
      <a
        href="/professional"
        class="w-full min-h-12 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-primary hover:bg-primary-container text-on-primary font-semibold text-sm sm:text-base shadow-md hover:shadow-xl transition-all duration-200 group-hover:translate-x-0.5"
      >
        <span>Read the normal way</span>
        <span
          class="material-symbols-outlined text-lg leading-none transition-transform group-hover:translate-x-1"
          >arrow_forward</span
        >
      </a>
      <span
        class="block text-center mt-2 font-mono text-xs text-on-surface-variant/70"
      >
        Estimated read: 4–6 minutes · Recruiter &amp; Exec Friendly
      </span>
    </div>
  </div>

  <!-- ══ CARD 2: Engineer ════════════════════════════════════ -->
  <div
    id="card-eng"
    class="reveal-on-scroll delay-200 group relative flex flex-col justify-between p-5 sm:p-7 lg:p-8 rounded-2xl bg-[#0e1117] text-[#e6edf3] border border-[#30363d] shadow-md card-hover-eng card-spotlight overflow-hidden transition-all duration-300"
  >
    <!-- Top accent line (terminal green) -->
    <div
      class="absolute top-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#2ea043] via-[#3fb950] to-[#56d364]"
    >
    </div>

    <div class="flex flex-col gap-4">
      <!-- Card header — wraps on very small screens -->
      <div class="flex items-start justify-between gap-2 flex-wrap">
        <div
          class="w-11 h-11 rounded-xl bg-[#161b22] border border-[#30363d] flex items-center justify-center text-[#3fb950] shadow-xs group-hover:scale-110 transition-transform shrink-0"
        >
          <span class="material-symbols-outlined text-2xl leading-none"
            >terminal</span
          >
        </div>
        <span
          class="px-3 py-1 rounded-sm bg-[#161b22] border border-[#30363d] text-[#3fb950] font-mono text-xs tracking-wider uppercase flex items-center gap-1.5 font-bold shrink-0"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-[#3fb950] animate-ping"
          ></span>
          LIVE CLI TTY
        </span>
      </div>

      <!-- Title -->
      <div>
        <div class="flex items-baseline gap-2 flex-wrap">
          <h2
            class="text-2xl sm:text-3xl font-bold text-white flex items-center gap-2"
          >
            Engineer
            <span class="text-[#3fb950] font-mono text-lg">&gt;_</span>
          </h2>
          <span class="font-mono text-xs text-[#8b949e]">MODE 02</span>
        </div>
        <p class="text-sm sm:text-base text-[#8b949e] mt-1">
          Raw data, terminal specs, and code telemetry.
        </p>
      </div>

      <!-- JSON terminal preview -->
      <div
        class="rounded-xl bg-[#090d13] p-3 sm:p-4 shadow-2xl overflow-x-auto relative border border-[#30363d]"
      >
        <!-- Window controls -->
        <div
          class="flex items-center justify-between pb-2 mb-2 border-b border-[#21262d]"
        >
          <div class="flex items-center gap-1.5 min-w-0">
            <span class="w-2.5 h-2.5 rounded-full bg-[#f85149] shrink-0"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#d29922] shrink-0"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-[#2ea043] shrink-0"></span>
            <span class="ml-2 font-mono text-xs text-[#8b949e] truncate"
              >~/portfolio.json</span
            >
          </div>
          <button
            id="copy-json-btn"
            type="button"
            title="Copy to clipboard"
            class="font-mono text-xs text-[#8b949e] hover:text-[#3fb950] flex items-center gap-1 transition-colors cursor-pointer shrink-0 ml-2"
          >
            <span class="material-symbols-outlined text-sm leading-none"
              >content_copy</span
            >
            <span id="copy-text">COPY</span>
          </button>
        </div>
        <!-- Code with line numbers -->
        <pre
          class="font-mono text-xs leading-relaxed overflow-x-auto selection:bg-[#2ea043]/30"><code class="block text-[#e6edf3]" set:html={`<span class="text-[#484f58] select-none">01 </span><span class="text-[#ff7b72]">{</span>
<span class="text-[#484f58] select-none">02 </span>  <span class="text-[#7ee787]">"engineer"</span><span class="text-[#ff7b72]">:</span> <span class="text-[#a5d6ff]">"Rushikesh Kadam"</span><span class="text-[#ff7b72]">,</span>
<span class="text-[#484f58] select-none">03 </span>  <span class="text-[#7ee787]">"role"</span><span class="text-[#ff7b72]">:</span> <span class="text-[#a5d6ff]">"AI Full Stack Engineer"</span><span class="text-[#ff7b72]">,</span>
<span class="text-[#484f58] select-none">04 </span>  <span class="text-[#7ee787]">"github"</span><span class="text-[#ff7b72]">:</span> <span class="text-[#a5d6ff]">"rushikadam12"</span><span class="text-[#ff7b72]">,</span>
<span class="text-[#484f58] select-none">05 </span>  <span class="text-[#7ee787]">"stack"</span><span class="text-[#ff7b72]">:</span> <span class="text-[#ff7b72]">[</span><span class="text-[#a5d6ff]">"Python"</span><span class="text-[#ff7b72]">,</span> <span class="text-[#a5d6ff]">"FastAPI"</span><span class="text-[#ff7b72]">,</span> <span class="text-[#a5d6ff]">"TypeScript"</span><span class="text-[#ff7b72]">,</span> <span class="text-[#a5d6ff]">"Node.js"</span><span class="text-[#ff7b72]">],</span>
<span class="text-[#484f58] select-none">06 </span>  <span class="text-[#7ee787]">"status"</span><span class="text-[#ff7b72]">:</span> <span class="text-[#a5d6ff]">"open_to_work"</span>
<span class="text-[#484f58] select-none">07 </span><span class="text-[#ff7b72]">}</span>`} /></pre>
      </div>

      <!-- Feature bullets -->
      <ul class="space-y-1.5 font-mono text-xs text-[#8b949e]">
        <li class="flex items-center gap-2">
          <span class="text-[#3fb950] font-bold shrink-0">[+]</span>
          <span>Direct access to tech specs &amp; architecture notes</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="text-[#3fb950] font-bold shrink-0">[+]</span>
          <span>Interactive CLI-style project queries &amp; filtering</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="text-[#3fb950] font-bold shrink-0">[+]</span>
          <span>Raw tech stack inspection &amp; GitHub repositories</span>
        </li>
        <li class="flex items-center gap-2">
          <span class="text-[#3fb950] font-bold shrink-0">[+]</span>
          <span>Zero fluff. Data and code first.</span>
        </li>
      </ul>
    </div>

    <!-- CTA -->
    <div class="pt-5 mt-2">
      <a
        href="/engineer"
        class="w-full min-h-12 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#238636] hover:bg-[#2ea043] text-white font-mono text-sm tracking-wider uppercase transition-all duration-200 group-hover:translate-x-0.5 shadow-sm font-semibold hover:shadow-lg hover:scale-[1.01] active:scale-[0.99]"
      >
        <span>cat portfolio.json</span>
        <span
          class="material-symbols-outlined text-lg leading-none transition-transform group-hover:translate-x-1"
          >arrow_forward</span
        >
      </a>
      <span class="block text-center mt-2 font-mono text-xs text-[#8b949e]">
        Payload: ~12KB gzip · Tailored for Developers &amp; Architects
      </span>
    </div>
  </div>
</section>

<!-- ── Alternative Path / Skip Link ────────────────────────── -->
<section
  class="reveal-on-scroll delay-300 flex flex-col items-center justify-center text-center pb-8 px-2"
>
  <div
    class="p-3.5 sm:p-4 rounded-xl bg-surface-container border border-outline-variant/30 flex flex-col sm:flex-row items-center gap-2 sm:gap-4 shadow-xs w-full max-w-lg hover:border-primary/40 transition-colors"
  >
    <span
      class="material-symbols-outlined text-primary text-xl leading-none shrink-0"
      >help_outline</span
    >
    <span class="text-xs sm:text-sm text-on-surface">
      Can't decide? You can switch views anytime via the header buttons.
    </span>
    <a
      href="/professional"
      class="text-xs sm:text-sm text-primary hover:text-primary-container font-semibold inline-flex items-center gap-1 hover:underline shrink-0"
    >
      Skip → Professional view
    </a>
  </div>
</section>

<!-- ── Client Scripts ─────────────────────────────────────── -->
<script>
  import { navigate } from "astro:transitions/client";

  function setupDecisionCards() {
    const copyBtn = document.getElementById("copy-json-btn");
    const copyText = document.getElementById("copy-text");

    if (copyBtn && copyText) {
      const snippet = JSON.stringify(
        {
          engineer: "Rushikesh Kadam",
          role: "AI Full Stack Engineer",
          github: "rushikadam12",
          stack: ["Python", "LangChain", "FastAPI", "TypeScript", "React"],
          status: "open_to_work",
        },
        null,
        2,
      );

      copyBtn.onclick = (e) => {
        e.preventDefault();
        navigator.clipboard.writeText(snippet).then(() => {
          const original = copyText.textContent ?? "COPY";
          copyText.textContent = "COPIED!";
          copyText.classList.add("text-[#3fb950]");
          setTimeout(() => {
            copyText.textContent = original;
            copyText.classList.remove("text-[#3fb950]");
          }, 2000);
        });
      };
    }

    // Keyboard shortcuts: 1 for Pro, 2 for Eng (smooth View Transitions)
    window.onkeydown = (evt) => {
      if (
        evt.target instanceof HTMLInputElement ||
        evt.target instanceof HTMLTextAreaElement
      )
        return;

      if (evt.key === "1") navigate("/professional");
      if (evt.key === "2") navigate("/engineer");
    };
  }

  setupDecisionCards();
  document.addEventListener("astro:page-load", setupDecisionCards);
</script>
