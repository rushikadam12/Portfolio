---
// EngContent.astro — Engineer view: an editor with a file explorer (left) and the
// portfolio as open files (right). Every fact comes from src/data/profile.ts.
import Icon from "../common/Icon.astro";
import CodeFile from "./CodeFile.astro";
import { profile, experience, focusAreas, stack } from "../../data/profile";
import { jsonLines, key, str, com, p, txt, num, type Line } from "../../lib/code";

const profileJson = jsonLines(
  {
    name: profile.name,
    role: profile.role,
    company: profile.company,
    experience: profile.experience,
    focus: ["LLM pipelines", "FastAPI services", "TypeScript front ends"],
    open_to_work: profile.openToWork,
    github: profile.links.github.href,
  },
  { github: profile.links.github.href },
);

const experienceTs: Line[] = [
  [com("// Where I work now")],
  [key("export const"), txt(" experience "), p("= [")],
  ...experience.flatMap((job): Line[] => [
    [txt("  "), p("{")],
    [txt("    role"), p(": "), str(job.role), p(",")],
    [txt("    company"), p(": "), str(job.company), p(",")],
    ...(job.period ? [[txt("    period"), p(": "), str(job.period), p(",")]] : []),
    [txt("    current"), p(": "), num(String(job.current)), p(",")],
    [txt("    work"), p(": [")],
    ...job.points.map((pt): Line => [txt("      "), str(pt), p(",")]),
    [txt("    "), p("],")],
    [txt("  "), p("},")],
  ]),
  [p("];")],
];

// Flow-style YAML: one line per group keeps the file short
const stackYaml: Line[] = stack.map((row): Line => [
  key(row.key),
  p(": ["),
  ...row.tools.flatMap((t, i) => (i ? [p(", "), txt(t)] : [txt(t)])),
  p("]"),
]);

const contactSh: Line[] = [
  [com("#!/usr/bin/env bash")],
  [com("# Email is the fastest way to reach me.")],
  [key("open"), txt(" "), str(`mailto:${profile.email.display}`, profile.email.href)],
  [],
  [com("# Code and work history")],
  [key("open"), txt(" "), str(profile.links.github.href, profile.links.github.href)],
  [key("open"), txt(" "), str(profile.links.linkedin.href, profile.links.linkedin.href)],
];

const files = [
  { id: "readme", name: "README.md" },
  { id: "profile", name: "profile.json" },
  { id: "experience", name: "experience.ts" },
  { id: "stack", name: "stack.yaml" },
  ...focusAreas.map((f) => ({ id: f.file.replace(".md", ""), name: `focus/${f.file}` })),
  { id: "contact", name: "contact.sh" },
];
---

<div class="wrap grid gap-6 pt-24 pb-16 sm:pt-28 lg:grid-cols-[13rem_1fr] lg:gap-8">
  <!-- Explorer -->
  <nav aria-label="Files" class="lg:sticky lg:top-24 lg:self-start">
    <p class="mb-2 flex items-center gap-2 font-mono text-xs text-muted">
      <Icon name="folder" size={14} /> rushikesh-kadam
    </p>
    <ul class="flex flex-wrap gap-x-1 font-mono text-[0.8125rem] lg:flex-col">
      {files.map((f) => (
        <li>
          <a href={`#${f.id}`} class="flex min-h-10 items-center rounded-md px-2 text-muted transition-colors hover:bg-surface hover:text-ink">
            {f.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Open files -->
  <div class="grid min-w-0 gap-6">
    <CodeFile id="readme" file="README.md" enter>
      <h1 class="font-mono text-2xl font-medium tracking-tight text-ed-text sm:text-[2rem]">
        <span class="text-ed-muted" aria-hidden="true"># </span>{profile.name}
      </h1>
      <p class="mt-4 max-w-[44rem] text-ed-text">{profile.summary}</p>
      <p class="mt-4 font-mono text-sm text-ed-text">
        <span class="text-ed-ok">$</span> {profile.role} at {profile.company}, {profile.experience}, open to new roles.
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href={profile.email.href} class="btn btn-primary"><Icon name="mail" size={17} /> Email me</a>
        <a href="/professional" class="btn btn-secondary">Read the profile instead</a>
      </div>
    </CodeFile>

    <CodeFile id="profile" file="profile.json" lines={profileJson} />
    <CodeFile id="experience" file="experience.ts" lines={experienceTs} />
    <CodeFile id="stack" file="stack.yaml" lines={stackYaml} />

    {focusAreas.map((area) => (
      <CodeFile id={area.file.replace(".md", "")} file={`focus/${area.file}`}>
        <p class="font-mono text-base font-medium text-ed-text"><span class="text-ed-muted" aria-hidden="true">## </span>{area.name}</p>
        <p class="mt-3 max-w-[44rem] text-ed-text">{area.body}</p>
        <p class="mt-4 font-mono text-sm text-ed-muted">tools: {area.tools.join(", ")}</p>
      </CodeFile>
    ))}

    <CodeFile id="contact" file="contact.sh" lines={contactSh} />
  </div>
</div>
