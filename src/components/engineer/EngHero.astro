---
// src/components/engineer/EngHero.astro
// Engineer view hero — dual-mode terminal aesthetic (adapts smoothly to Light and Dark modes)
---

<section
  class="reveal-on-scroll rounded-2xl bg-white dark:bg-[#0d1117] text-[#24292f] dark:text-[#e6edf3] p-3 sm:p-6 md:p-8 relative overflow-hidden mt-4 mb-6 shadow-xl border border-[#d0d7de] dark:border-[#30363d] transition-colors w-full min-w-0"
>
  <!-- Accent Line (Terminal Green in both modes) -->
  <div
    class="absolute top-0 inset-x-0 h-1 bg-gradient-to-r from-[#1a7f37] via-[#2ea043] to-[#3fb950]"
  >
  </div>

  <!-- Terminal Window Chrome -->
  <div
    class="flex items-center justify-between gap-2 pb-2.5 sm:pb-3 mb-3 border-b border-[#d0d7de] dark:border-[#21262d] min-w-0 w-full"
  >
    <div class="flex items-center gap-1.5 sm:gap-2 min-w-0 flex-1">
      <div class="flex items-center gap-1.5 shrink-0">
        <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#f85149] inline-block"></span>
        <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#d29922] inline-block"></span>
        <span class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-[#2ea043] inline-block"></span>
      </div>
      <span
        class="ml-1 sm:ml-2 font-mono text-[11px] sm:text-xs text-[#57606a] dark:text-[#8b949e] truncate min-w-0"
      >
        ~/portfolio $ whoami
      </span>
    </div>
    <div class="flex items-center gap-1.5 shrink-0">
      <span
        class="font-mono text-[10px] sm:text-xs text-[#1a7f37] dark:text-[#3fb950] font-bold px-1.5 sm:px-2 py-0.5 rounded bg-[#dafbe1] dark:bg-[#161b22] border border-[#2ea043]/30 whitespace-nowrap"
      >
        TTY_ACTIVE
      </span>
      <span
        class="font-mono text-xs text-[#57606a] dark:text-[#8b949e] hidden sm:inline"
      >
        zsh 5.9
      </span>
    </div>
  </div>

  <!-- Code Output Block (Syntax highlighted for both Light & Dark modes) -->
  <pre
    class="font-mono text-[11px] sm:text-xs md:text-sm leading-relaxed overflow-x-auto p-2.5 sm:p-3.5 rounded-lg bg-[#f6f8fa] dark:bg-[#090d13] border border-[#d0d7de]/50 dark:border-[#21262d] w-full min-w-0 selection:bg-[#2ea043]/30"
  ><code class="block text-[#24292f] dark:text-[#e6edf3]"><div><span class="text-[#cf222e] dark:text-[#ff7b72] font-semibold">const</span> engineer <span class="text-[#57606a] dark:text-[#8b949e]">=</span> &#123;</div>  <span class="text-[#0550ae] dark:text-[#79c0ff]">name</span>: <span class="text-[#0a3069] dark:text-[#a5d6ff]">"Rushikesh Kadam"</span>,
  <span class="text-[#0550ae] dark:text-[#79c0ff]">role</span>: <span class="text-[#0a3069] dark:text-[#a5d6ff]">"AI Full Stack Engineer"</span>,
  <span class="text-[#0550ae] dark:text-[#79c0ff]">experience</span>: <span class="text-[#1a7f37] dark:text-[#3fb950] font-semibold">"2.5+ years"</span>,
  <span class="text-[#0550ae] dark:text-[#79c0ff]">github</span>: <span class="text-[#0a3069] dark:text-[#a5d6ff]">"rushikadam12"</span>,
  <span class="text-[#0550ae] dark:text-[#79c0ff]">stack</span>: [
    <span class="text-[#0a3069] dark:text-[#a5d6ff]">"Python"</span>, <span class="text-[#0a3069] dark:text-[#a5d6ff]">"LangChain"</span>, <span class="text-[#0a3069] dark:text-[#a5d6ff]">"FastAPI"</span>,
    <span class="text-[#0a3069] dark:text-[#a5d6ff]">"TypeScript"</span>, <span class="text-[#0a3069] dark:text-[#a5d6ff]">"React"</span>, <span class="text-[#0a3069] dark:text-[#a5d6ff]">"OpenAI API"</span>
  ],
  <span class="text-[#0550ae] dark:text-[#79c0ff]">status</span>: <span class="text-[#1a7f37] dark:text-[#3fb950] font-semibold">"open_to_work"</span>,
  <span class="text-[#0550ae] dark:text-[#79c0ff]">focus</span>: <span class="text-[#0a3069] dark:text-[#a5d6ff]">"AI Systems &amp; Full Stack"</span>
&#125;;</code></pre>

  <!-- Interactive Terminal command strip -->
  <div
    class="mt-3 sm:mt-4 flex flex-wrap items-center justify-between gap-2 pt-2.5 sm:pt-3 border-t border-[#d0d7de] dark:border-[#21262d] min-w-0"
  >
    <div
      class="flex items-center gap-1.5 font-mono text-xs text-[#1a7f37] dark:text-[#3fb950] shrink-0"
    >
      <span class="font-bold">~/portfolio $</span>
      <span
        class="w-2 h-4 bg-[#1a7f37] dark:bg-[#3fb950] animate-pulse inline-block"
      ></span>
    </div>

    <!-- Quick Switch to Professional View -->
    <a
      href="/professional"
      class="inline-flex items-center gap-1 font-mono text-[11px] sm:text-xs text-[#57606a] dark:text-[#8b949e] hover:text-primary transition-colors shrink-0"
    >
      <span class="material-symbols-outlined text-[15px] leading-none"
        >swap_horiz</span
      >
      <span>switch --mode professional</span>
    </a>
  </div>
</section>
