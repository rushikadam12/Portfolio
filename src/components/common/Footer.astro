---
// Footer.astro — contact links and copyright, one line on desktop.
import { profile } from "../../data/profile";
---

<footer class="border-t border-rule">
  <div class="wrap flex flex-col gap-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-1">
      <li><a class="inline-flex min-h-11 items-center hover:text-ink" href={profile.email.href}>{profile.email.display}</a></li>
      <li><a class="inline-flex min-h-11 items-center hover:text-ink" href={profile.links.github.href} rel="noopener noreferrer" target="_blank">GitHub</a></li>
      <li><a class="inline-flex min-h-11 items-center hover:text-ink" href={profile.links.linkedin.href} rel="noopener noreferrer" target="_blank">LinkedIn</a></li>
    </ul>
  </div>
</footer>
