---
// Header.astro — site header: name, view switch (Professional / Engineer), theme toggle.
// Small enough to fit a 320px screen, so there is no mobile drawer.
import Icon from "./Icon.astro";
import { profile } from "../../data/profile";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const views = [
  { href: "/professional", label: "Professional" },
  { href: "/engineer", label: "Engineer" },
];
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-rule bg-paper/90 backdrop-blur-md">
  <div class="wrap flex h-16 items-center justify-between gap-3">
    <a href="/" class="flex min-h-11 items-center gap-2.5 font-semibold text-ink" aria-label={`${profile.name}, home`}>
      <span class="grid h-8 w-8 place-items-center rounded-md bg-ink text-[13px] font-bold tracking-tight text-paper">
        {profile.shortName}
      </span>
      <span class="hidden sm:inline">{profile.name}</span>
    </a>

    <div class="flex items-center gap-2">
      <nav aria-label="Choose a view" class="flex rounded-lg border border-rule p-0.5">
        {views.map((v) => {
          const active = path === v.href;
          return (
            <a
              href={v.href}
              aria-current={active ? "page" : undefined}
              class={`inline-flex min-h-10 items-center rounded-md px-3 text-sm transition-colors ${
                active ? "bg-ink font-semibold text-paper" : "text-muted hover:text-ink"
              }`}
            >
              {v.label}
            </a>
          );
        })}
      </nav>

      <button
        id="theme-toggle"
        type="button"
        class="grid h-11 w-11 place-items-center rounded-lg text-muted transition-colors hover:text-ink"
        aria-label="Switch to dark theme"
      >
        <span class="theme-icon-moon"><Icon name="moon" size={18} /></span>
        <span class="theme-icon-sun hidden"><Icon name="sun" size={18} /></span>
      </button>
    </div>
  </div>
</header>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn) return;
    const sync = () => {
      const dark = document.documentElement.classList.contains("dark");
      btn.querySelector(".theme-icon-sun")?.classList.toggle("hidden", !dark);
      btn.querySelector(".theme-icon-moon")?.classList.toggle("hidden", dark);
      btn.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
    };
    btn.onclick = () => {
      const dark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch {}
      sync();
    };
    sync();
  }
  setupThemeToggle();
  document.addEventListener("astro:page-load", setupThemeToggle);
</script>
