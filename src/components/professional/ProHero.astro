---
// ProHero.astro — Professional view hero: who, what, one action; photo on the right.
import { Image } from "astro:assets";
import Icon from "../common/Icon.astro";
import profilePhoto from "../../assets/profile-photo.jpeg";
import { profile } from "../../data/profile";
---

<section class="wrap grid items-center gap-10 pt-28 pb-16 sm:pt-36 md:grid-cols-[1fr_17rem] lg:grid-cols-[1fr_20rem] lg:gap-16" aria-labelledby="pro-title">
  <div data-enter>
    <p class="text-muted">{profile.role} at {profile.company}</p>
    <h1 id="pro-title" class="mt-3 text-[2.5rem] leading-[1.05] font-semibold tracking-[-0.03em] text-ink sm:text-[3.75rem]">
      {profile.name}
    </h1>
    <p class="mt-2 text-xl text-ink sm:text-2xl">AI and full-stack engineer, {profile.experience} in production.</p>
    <p class="mt-6 max-w-[38rem] text-lg text-muted">{profile.summary}</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={profile.email.href} class="btn btn-primary">
        <Icon name="mail" size={17} /> Email me
      </a>
      <a href={profile.links.github.href} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        See my GitHub <Icon name="external" size={16} />
      </a>
    </div>
  </div>

  <div class="order-first md:order-none" data-enter>
    <Image
      src={profilePhoto}
      alt={`Portrait of ${profile.name}`}
      widths={[240, 400, 640]}
      sizes="(min-width: 1024px) 20rem, (min-width: 768px) 17rem, 10rem"
      loading="eager"
      class="aspect-[4/5] w-40 rounded-xl object-cover md:w-full"
    />
  </div>
</section>
