---
// src/components/professional/ProHero.astro
// Professional view hero — editorial layout with Rushikesh's profile photo
import profilePhoto from '../../assets/profile-photo.jpeg';
---

<section class="reveal-on-scroll flex flex-col md:flex-row items-center md:items-start gap-6 sm:gap-8 lg:gap-10 pt-4 sm:pt-6 pb-8 sm:pb-12 border-b border-outline-variant/30 text-center md:text-left">

  <!-- ── Profile Photo ──────────────────────────────────── -->
  <div class="reveal-on-scroll delay-75 shrink-0 relative group">
    <div class="w-32 h-32 sm:w-40 sm:h-40 md:w-48 md:h-48 rounded-2xl overflow-hidden ring-4 ring-primary/20 shadow-xl bg-surface-container-high transition-transform duration-300 group-hover:scale-105">
      <img
        src={profilePhoto.src}
        alt="Rushikesh Kadam"
        class="w-full h-full object-cover"
        loading="eager"
      />
    </div>
    <!-- Status badge -->
    <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 md:left-auto md:right-2 md:translate-x-0 px-2.5 py-1 rounded-full bg-surface-container-lowest border border-outline-variant/30 shadow-sm flex items-center gap-1.5 whitespace-nowrap">
      <span class="w-2 h-2 rounded-full bg-secondary animate-pulse"></span>
      <span class="font-mono text-xs text-on-surface-variant font-semibold tracking-wide">AVAILABLE</span>
    </div>
  </div>

  <!-- ── Intro Copy ─────────────────────────────────────── -->
  <div class="reveal-on-scroll delay-150 flex flex-col gap-3 sm:gap-4 flex-1 mt-2 md:mt-0">

    <!-- Eyebrow -->
    <div class="inline-flex items-center justify-center md:justify-start gap-2">
      <span class="font-mono text-xs text-primary font-bold uppercase tracking-wider bg-primary/10 px-3 py-1 rounded-full">
        Mode 01 · Executive Dossier
      </span>
    </div>

    <!-- Name + role -->
    <div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-on-surface tracking-tight leading-tight">
        Rushikesh Kadam
      </h1>
      <p class="text-lg sm:text-xl font-medium text-on-surface-variant mt-1">
        AI Engineer &amp; Full Stack Engineer
      </p>
    </div>

    <!-- Experience chips -->
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary/10 border border-primary/20 font-mono text-xs text-primary font-semibold hover:scale-105 transition-transform cursor-default">
        <span class="material-symbols-outlined text-sm leading-none">work_history</span>
        2.5+ YRS EXPERIENCE
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary/10 border border-secondary/20 font-mono text-xs text-secondary font-semibold hover:scale-105 transition-transform cursor-default">
        <span class="material-symbols-outlined text-sm leading-none">psychology</span>
        AI ENGINEERING
      </span>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container border border-outline-variant/30 font-mono text-xs text-on-surface-variant font-semibold hover:scale-105 transition-transform cursor-default">
        <span class="material-symbols-outlined text-sm leading-none">terminal</span>
        FULL STACK
      </span>
    </div>

    <!-- Summary -->
    <p class="text-sm sm:text-base text-on-surface-variant max-w-2xl leading-relaxed">
      With 2.5+ years of hands-on experience, I build AI-powered systems and
      production-grade web applications — from LLM integrations and agentic
      pipelines to scalable full-stack architectures. Passionate about merging
      AI capabilities with clean engineering to deliver real-world impact.
      Open to AI engineering, full-stack, and backend opportunities.
    </p>

    <!-- CTA Row -->
    <div class="flex flex-col sm:flex-row flex-wrap items-center justify-center md:justify-start gap-2.5 pt-2">
      <a
        href="mailto:rushi55578@gmail.com"
        class="w-full sm:w-auto min-h-11 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-on-primary text-sm font-semibold shadow-md hover:shadow-xl hover:-translate-y-0.5 active:scale-95 transition-all"
      >
        <span class="material-symbols-outlined text-lg leading-none">mail</span>
        Get in touch
      </a>

      <a
        href="/resume.pdf"
        class="w-full sm:w-auto min-h-11 inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high text-on-surface text-sm font-semibold border border-outline-variant/30 shadow-xs hover:-translate-y-0.5 active:scale-95 transition-all"
      >
        <span class="material-symbols-outlined text-lg leading-none">picture_as_pdf</span>
        Resume PDF
      </a>

      <a
        href="/engineer"
        class="w-full sm:w-auto min-h-11 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-outline-variant text-on-surface-variant font-mono text-xs hover:text-on-surface hover:bg-surface-container hover:-translate-y-0.5 active:scale-95 transition-all"
      >
        <span class="material-symbols-outlined text-base leading-none">terminal</span>
        Switch to Engineer view ⚡
      </a>
    </div>

  </div>
</section>
