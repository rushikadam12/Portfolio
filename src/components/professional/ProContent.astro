---
// src/components/professional/ProContent.astro
// Professional content: experience timeline, skills, and case study cards

interface Job {
  title: string;
  company: string;
  period: string;
  bullets: string[];
}

interface Project {
  name: string;
  description: string;
  tags: string[];
  impact: string;
}

const experience: Job[] = [
  {
    title:   "AI Engineer & Full Stack Engineer",
    company: "Company Name",
    period:  "2024 — Present",
    bullets: [
      "Built LLM-powered agentic pipelines using LangChain, OpenAI API, and Python",
      "Architected and shipped 3 SaaS products serving 10k+ active users",
      "Reduced page load time by 60% through SSR and code-splitting strategies",
    ],
  },
  {
    title:   "Full Stack Engineer",
    company: "Previous Company",
    period:  "2022 — 2024",
    bullets: [
      "Built reusable component library adopted across 4 product teams",
      "Integrated third-party APIs (Stripe, Auth0, Firebase) into production apps",
      "Mentored 2 junior developers through onboarding and growth plans",
    ],
  },
];

const projects: Project[] = [
  {
    name:        "AI-Powered Agentic Systems",
    description: "LLM integration pipelines and RAG architectures using LangChain, LlamaIndex, and OpenAI API with FastAPI backends.",
    tags:        ["Python", "LangChain", "OpenAI API", "FastAPI", "Docker"],
    impact:      "Reduced manual processing time by 70%",
  },
  {
    name:        "Full-Stack Web Platforms",
    description: "Scalable modern web applications integrating TypeScript frontends with Node.js & Python backend services.",
    tags:        ["TypeScript", "React", "Node.js", "FastAPI", "Tailwind CSS"],
    impact:      "10k+ active users across production deployments",
  },
];
---

<div class="flex flex-col gap-space-lg sm:gap-space-xl pt-space-lg sm:pt-space-xl">

  <!-- ── Experience Timeline ─────────────────────────────── -->
  <section class="reveal-on-scroll">
    <h2 class="font-headline-md text-xl sm:text-headline-md text-on-surface mb-space-md sm:mb-space-lg font-bold">
      Experience
    </h2>
    <div class="flex flex-col gap-space-md sm:gap-space-lg">
      {experience.map((job, idx) => (
        <div class={`reveal-on-scroll delay-${(idx + 1) * 150} flex gap-3 sm:gap-space-md`}>
          <!-- Timeline dot -->
          <div class="flex flex-col items-center pt-1.5 shrink-0">
            <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 rounded-full bg-primary ring-4 ring-primary/20"></div>
            <div class="w-px flex-1 bg-outline-variant/40 mt-2"></div>
          </div>
          <!-- Content -->
          <div class="flex flex-col gap-1 sm:gap-space-xs pb-space-md sm:pb-space-lg flex-1 min-w-0 p-3 sm:p-4 rounded-xl hover:bg-surface-container/50 transition-colors">
            <!-- Title row — stacks on mobile -->
            <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-0.5 sm:gap-2">
              <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-baseline gap-0.5 sm:gap-2 min-w-0">
                <span class="font-headline-sm text-sm sm:text-base text-on-surface font-semibold leading-snug">{job.title}</span>
                <span class="font-body-sm text-xs text-on-surface-variant font-medium">@ {job.company}</span>
              </div>
              <span class="font-label-mono text-xs text-outline shrink-0">{job.period}</span>
            </div>
            <ul class="flex flex-col gap-1.5 mt-1 sm:mt-2">
              {job.bullets.map((b) => (
                <li class="flex items-start gap-2 text-xs sm:text-sm text-on-surface-variant leading-relaxed">
                  <span class="material-symbols-outlined text-primary text-base leading-none mt-0.5 shrink-0">check_circle</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Case Studies ────────────────────────────────────── -->
  <section class="reveal-on-scroll">
    <h2 class="font-headline-md text-xl sm:text-headline-md text-on-surface mb-space-md sm:mb-space-lg font-bold">
      Case Studies
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">
      {projects.map((p, idx) => (
        <div class={`reveal-on-scroll delay-${(idx + 1) * 150} p-4 sm:p-space-lg rounded-2xl bg-surface-container-lowest shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between gap-space-sm border border-outline-variant/30 hover:border-primary/40 group`}>
          <div class="flex flex-col gap-1.5 sm:gap-2">
            <h3 class="font-headline-sm text-base sm:text-headline-sm text-on-surface font-semibold leading-snug group-hover:text-primary transition-colors">{p.name}</h3>
            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">{p.description}</p>
            <div class="flex flex-wrap gap-1.5 mt-1">
              {p.tags.map((tag) => (
                <span class="px-2 py-0.5 rounded-full bg-primary-fixed text-on-primary-fixed font-label-mono text-xs uppercase tracking-wide">
                  {tag}
                </span>
              ))}
            </div>
          </div>
          <div class="flex items-center gap-2 mt-2 pt-2 border-t border-outline-variant/20">
            <span class="material-symbols-outlined text-secondary text-base leading-none shrink-0">trending_up</span>
            <span class="text-xs sm:text-sm text-on-surface-variant font-medium">{p.impact}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── Core Skills ─────────────────────────────────────── -->
  <section class="reveal-on-scroll pb-space-lg sm:pb-space-xl">
    <h2 class="font-headline-md text-xl sm:text-headline-md text-on-surface mb-space-md sm:mb-space-lg font-bold">
      Core Skills
    </h2>
    <div class="flex flex-wrap gap-2 sm:gap-space-sm">
      {[
        "Python","LangChain","FastAPI","TypeScript","React",
        "Next.js","Astro","PostgreSQL","Docker","Tailwind CSS",
        "OpenAI API","SQLAlchemy","GitHub Actions","REST & GraphQL"
      ].map((skill, idx) => (
        <span class={`reveal-on-scroll delay-${(idx % 6 + 1) * 75} px-3 sm:px-space-md py-1.5 sm:py-2 rounded-lg bg-surface-container border border-outline-variant/20 text-xs sm:text-sm text-on-surface shadow-sm hover:-translate-y-0.5 hover:border-primary/50 hover:bg-surface-container-high transition-all duration-200 cursor-default`}>
          {skill}
        </span>
      ))}
    </div>
  </section>

</div>
