---
// ProContent.astro — Professional view body: experience, focus areas, skills, contact.
// Each section is a two-column row on desktop: heading left, content right.
import { profile, experience, focusAreas, stack } from "../../data/profile";
---

<section class="border-t border-rule" aria-labelledby="work-title">
  <div class="wrap grid gap-8 py-16 md:grid-cols-[14rem_1fr] md:py-24">
    <h2 id="work-title" class="text-2xl font-semibold tracking-tight text-ink">Experience</h2>
    <ol class="grid gap-10">
      {experience.map((job) => (
        <li>
          <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="text-lg font-semibold text-ink">{job.role}, {job.company}</h3>
            {(job.period || job.current) && (
              <p class="text-sm text-muted">{job.period || "Current role"}</p>
            )}
          </div>
          <ul class="mt-4 grid max-w-[42rem] gap-2 text-muted">
            {job.points.map((point) => (
              <li class="relative pl-5 before:absolute before:left-0 before:top-[0.7em] before:h-px before:w-2.5 before:bg-muted">
                {point}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="border-t border-rule" aria-labelledby="focus-title">
  <div class="wrap grid gap-8 py-16 md:grid-cols-[14rem_1fr] md:py-24">
    <h2 id="focus-title" class="text-2xl font-semibold tracking-tight text-ink">What I build</h2>
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-12">
      {focusAreas.map((area) => (
        <article>
          <h3 class="text-lg font-semibold text-ink">{area.name}</h3>
          <p class="mt-3 text-muted">{area.body}</p>
          <p class="mt-4 text-sm text-ink">{area.tools.join(", ")}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="border-t border-rule" aria-labelledby="skills-title">
  <div class="wrap grid gap-8 py-16 md:grid-cols-[14rem_1fr] md:py-24">
    <h2 id="skills-title" class="text-2xl font-semibold tracking-tight text-ink">Skills</h2>
    <dl class="grid divide-y divide-rule border-y border-rule">
      {stack.map((row) => (
        <div class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <dt class="font-medium text-ink">{row.group}</dt>
          <dd class="text-muted">{row.tools.join(", ")}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section class="border-t border-rule bg-surface" aria-labelledby="contact-title">
  <div class="wrap py-20 md:py-28">
    <h2 id="contact-title" class="text-2xl font-semibold tracking-tight text-ink">Contact</h2>
    <p class="mt-3 max-w-xl text-ink">
      Open to AI engineering, full-stack and backend roles. Email is the fastest way to reach me.
    </p>
    <a
      href={profile.email.href}
      class="mt-8 inline-block break-all text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-ink underline decoration-rule decoration-2 underline-offset-[0.2em] transition-colors hover:decoration-accent focus-visible:decoration-accent sm:text-[3rem]"
    >
      {profile.email.display}
    </a>
    <p class="mt-8 flex flex-wrap gap-x-6 text-muted">
      <a class="link inline-flex min-h-11 items-center" href={profile.links.github.href} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a class="link inline-flex min-h-11 items-center" href={profile.links.linkedin.href} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </p>
  </div>
</section>
